<?xml version="1.0" encoding="utf-8"?>
<!-- Merged only into games that add nearby-hotspot (docs/LOCAL-HOTSPOT.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Install-time: start the hotspot, join a network, bind sockets to it. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Runtime, host only: Android 8 to 12 need location for startLocalOnlyHotspot; Android 13+ need Nearby devices. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
</manifest>
